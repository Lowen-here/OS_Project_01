#include <stdio.h>
#include <string.h>

int
find_completion_start(char *buf, int len, int *is_first_word)
{
  int start = len;
  int i;

  while (start > 0 &&
         buf[start - 1] != ' ' &&
         buf[start - 1] != '\t') {
    start--;
  }

  *is_first_word = 1;

  for (i = 0; i < start; i++) {
    if (buf[i] != ' ' && buf[i] != '\t') {
      *is_first_word = 0;
      break;
    }
  }

  return start;
}

