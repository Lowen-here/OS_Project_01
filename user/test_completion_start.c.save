int
main(void)
{
  char *tests[] = {
    "ec",
    "cat REA",
    "echo hel",
    "cat ",
    "  ec",
    "  cat   REA",
    ""
  };

  int count = sizeof(tests) / sizeof(tests[0]);

  for (int i = 0; i < count; i++) {
    int first;
    int len = strlen(tests[i]);

    int start = find_completion_start(tests[i], len, &first);

    printf("Input: \"%s\"\n", tests[i]);
    printf("Start: %d\n", start);
    printf("Prefix: \"%s\"\n", tests[i] + start);
    printf("First word: %d\n\n", first);
  }

  return 0;
